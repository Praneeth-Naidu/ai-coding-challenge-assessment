{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["tests/**/*.ts", "support/**/*.ts", "playwright.config.ts"]
}
